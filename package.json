{
  "name": "bpmsquare-qa-automation",
  "version": "1.0.0",
  "description": "BDD Automation Framework for BpmSquare using Playwright and Cucumber",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:ui": "cucumber-js --format html:reports/cucumber-report.html",
    "test:tags": "cucumber-js --tags",
    "test:parallel": "cucumber-js --parallel 2"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "automation",
    "bpmsquare"
  ],
  "author": "QA Team",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.40.0",
    "cucumber-html-reporter": "^5.0.2",
    "dotenv": "^16.6.1",
    "playwright": "^1.40.0"
  }
}
